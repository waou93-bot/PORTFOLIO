---
import { site } from '../../config/site';
interface Props {
  compact?: boolean;
}
---

<header class="site-header container">
  <a class="identity" href="/" aria-label="Nicolas Jez, accueil">NJ<span>Nicolas Jez</span></a><nav
    aria-label="Navigation principale"
  >
    {
      site.nav
        .filter((n) => n.href !== '/')
        .map((n) => (
          <a
            href={n.href}
            aria-current={Astro.url.pathname.startsWith(n.href) ? 'page' : undefined}
          >
            {n.label}
          </a>
        ))
    }
  </nav>
</header>
<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }
  .identity {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-weight: 800;
    font-size: 1.5rem;
  }
  .identity span {
    font-size: 0.85rem;
    font-weight: 500;
  }
  nav {
    display: flex;
    gap: 1.6rem;
    font-size: 0.85rem;
  }
  nav a {
    padding-block: 0.5rem;
  }
  nav a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }
  @media (max-width: 38rem) {
    .site-header {
      flex-wrap: wrap;
      gap: 0.7rem;
    }
    .identity span {
      font-size: 0.8rem;
    }
    nav {
      gap: 1.25rem;
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
