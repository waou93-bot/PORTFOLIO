---
import { site } from '../../config/site';
---

<footer class="container">
  <div class="footer-main">
    <p class="display">Une idée de site ?<br /><a href="/contact">Parlons-en.</a></p><a
      href={`mailto:${site.email}`}>{site.email}</a>
  </div><div class="footer-bottom">
    <span>© {new Date().getFullYear()} Nicolas Jez</span><nav aria-label="Informations">
      <a href="/mentions-legales">Mentions légales</a><a href="/confidentialite">Confidentialité</a
      ><a href="/methode">Méthode</a>
    </nav>
  </div>
</footer>
<style>
  footer {
    padding-block: 4rem 2rem;
    border-top: 1px solid var(--color-line);
  }
  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    padding-bottom: 3rem;
  }
  .footer-main p {
    font-size: clamp(2rem, 5vw, 4rem);
  }
  a {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-muted);
    font-size: 0.8rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.3rem;
  }
  @media (max-width: 40rem) {
    .footer-main,
    .footer-bottom {
      align-items: start;
      flex-direction: column;
    }
    .footer-main > a {
      font-size: 0.9rem;
    }
  }
</style>
