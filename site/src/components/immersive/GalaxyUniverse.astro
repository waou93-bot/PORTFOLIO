---
const projects = [
  {
    slug: 'down-trigger',
    name: 'Down Trigger',
    image: 'down-trigger/cover-v2.webp',
    detail: 'Collaboration · site en ligne',
    x: 24,
    y: 40,
  },
  {
    slug: 'heritage-2',
    name: 'Héritage 2',
    image: 'heritage-2/cover-v2.webp',
    detail: 'Concept fictif · étude de cas',
    x: 63,
    y: 40,
  },
  {
    slug: 'maison-sillon',
    name: 'Maison Sillon',
    image: 'maison-sillon/cover-v3.webp',
    detail: 'Concept architectural · étude de cas',
    x: 38,
    y: 72,
  },
  {
    slug: 'vantel',
    name: 'Vantel',
    image: 'vantel/cover.webp',
    detail: 'Concept e-commerce · expérience interactive',
    x: 77,
    y: 62,
  },
];
---

<section class="galaxy" data-galaxy aria-label="Carte du ciel des projets">
  <div class="galaxy-film" aria-hidden="true">
    <img
      class="galaxy-poster"
      src="/media/transition/universe-v3-poster.jpg"
      alt=""
      width="720"
      height="1280"
      loading="eager"
      fetchpriority="high"
    />
    <video muted playsinline preload="auto" poster="/media/transition/universe-v3-poster.jpg"
    ></video>
    <video muted playsinline preload="none"></video>
  </div>
  <header class="galaxy-title">
    <a href="/">← Retour au portrait</a><p>QUATRE PROJETS · UN UNIVERS</p><h1>
      Suivez votre<br /><em>curiosité.</em>
    </h1>
  </header>
  <div class="constellation">
    {
      projects.map((p, i) => (
        <div
          class:list={['star', { 'star-left': p.x > 50 }]}
          style={`--x:${p.x}%;--y:${p.y}%`}
          data-star
        >
          <button
            class="star-trigger"
            type="button"
            aria-expanded="false"
            aria-controls={`star-card-${i}`}
            aria-label={`Découvrir ${p.name}`}
          >
            <>
              <i aria-hidden="true" />
              <span>
                0{i + 1} / {p.name}
              </span>
            </>
          </button>
          <div class="star-reveal" id={`star-card-${i}`} hidden>
            <svg viewBox="0 0 260 60" aria-hidden="true">
              <path d="M 0 59 L 55 1 H 260" pathLength="1" />
            </svg>
            <a class="star-card" href={`/work/${p.slug}`}>
              <>
                <img
                  src={`/media/projects/${p.image}`}
                  alt=""
                  width="400"
                  height="250"
                  loading="eager"
                  decoding="async"
                />
                <div>
                  <>
                    <small>{p.detail}</small>
                    <strong>{p.name}</strong>
                    <span>Découvrir le projet ↗</span>
                  </>
                </div>
              </>
            </a>
          </div>
        </div>
      ))
    }
  </div>
  <div class="galaxy-controls">
    <p data-galaxy-status role="status">Survolez une étoile. Découvrez un projet.</p><button
      type="button"
      data-galaxy-pause
      aria-pressed="false">Pause du paysage</button
    >
  </div>
</section>
<nav class="galaxy-index" aria-label="Tous les projets">
  <span>Accès direct</span>{projects.map((p) => <a href={`/work/${p.slug}`}>{p.name} ↗</a>)}
</nav>
<script>
  import { initGalaxy } from '../../lib/galaxy-universe';
  initGalaxy();
  document.addEventListener('astro:page-load', initGalaxy);
</script>
<style>
  .galaxy {
    position: relative;
    isolation: isolate;
    min-height: 730px;
    height: calc(100svh - 68px);
    background: #090716;
    color: #f8f0ff;
    overflow: clip;
  }
  .galaxy-film {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .galaxy-film video,
  .galaxy-poster {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    inset: 0;
  }
  .galaxy-film video + video {
    opacity: 0;
  }
  .galaxy-title {
    position: absolute;
    top: 38px;
    left: 5vw;
    pointer-events: none;
  }
  .galaxy-title a {
    pointer-events: auto;
    color: inherit;
    font-size: 0.75rem;
  }
  .galaxy-title p {
    font-size: 0.63rem;
    letter-spacing: 0.19em;
    margin: 36px 0 12px;
  }
  .galaxy-title h1 {
    font-size: clamp(2.5rem, 4.3vw, 4.6rem);
    font-weight: 400;
    line-height: 0.98;
    margin: 0;
    text-shadow: 0 2px 20px #100b22;
  }
  .galaxy-title em {
    font-weight: 400;
  }
  .constellation {
    position: absolute;
    inset: 0;
  }
  .star {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 1px;
    height: 1px;
    z-index: 1;
  }
  .star[data-open='true'] {
    z-index: 8;
  }
  .star-trigger {
    position: absolute;
    left: -24px;
    top: -24px;
    width: 48px;
    height: 48px;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0;
  }
  .star-trigger i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 10px 3px #c6b3ff90,
      0 0 35px 9px #9a8cff38;
    transition:
      box-shadow 0.2s,
      scale 0.2s;
  }
  .star-trigger::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1px solid #dac9fc66;
    border-radius: 50%;
    transition: scale 0.2s;
  }
  .star-trigger span {
    position: absolute;
    top: 42px;
    white-space: nowrap;
    font-size: 11px;
    letter-spacing: 0.035em;
    text-shadow: 0 2px 7px #06030f;
  }
  .star-trigger:hover i,
  .star-trigger:focus-visible i {
    scale: 1.3;
    box-shadow: 0 0 18px 5px #e8dcffb0;
  }
  .star-trigger:focus-visible {
    outline: 1px solid #fff;
    border-radius: 50%;
  }
  .star-trigger {
    width: 60px;
    height: 60px;
    left: -30px;
    top: -30px;
  }
  .star-trigger i {
    width: 12px;
    height: 12px;
  }
  .star-trigger::after {
    inset: 10px;
  }
  .star-trigger span {
    top: 52px;
  }
  .star-reveal {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 260px;
    padding-bottom: 58px;
    pointer-events: none;
  }
  .star-reveal[hidden] {
    display: none;
  }
  .star-reveal svg {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 260px;
    height: 60px;
    overflow: visible;
  }
  .star-reveal path {
    fill: none;
    stroke: #eee3ff;
    stroke-width: 1;
    stroke-dasharray: 1;
    animation: trace-star 0.3s ease-out both;
  }
  .star-card {
    display: block;
    margin-left: 55px;
    width: 205px;
    pointer-events: auto;
    text-decoration: none !important;
    color: #f7f0ff;
    background: #151020ed;
    border: 1px solid #d4c0ee66;
    border-radius: 5px;
    overflow: hidden;
    box-shadow: 0 10px 35px #0005;
    animation: reveal-star 0.2s 0.13s both;
  }
  .star-card img {
    width: 100%;
    height: 106px;
    object-fit: cover;
    display: block;
  }
  .star-card > div {
    padding: 13px;
    display: grid;
    gap: 7px;
  }
  .star-card small {
    font-size: 10px;
    line-height: 1.5;
    color: #dacde4;
  }
  .star-card strong {
    font-size: 18px;
    font-weight: 500;
  }
  .star-card span {
    font-size: 10px;
    color: #e3d4f6;
  }
  .star-card:hover,
  .star-card:focus-visible {
    border-color: #fff;
    outline: 1px solid #fff9;
  }
  .star-left .star-reveal {
    left: auto;
    right: 0;
  }
  .star-left svg {
    transform: scaleX(-1);
  }
  .star-left .star-card {
    margin-left: 0;
  }
  .galaxy-controls {
    position: absolute;
    bottom: 24px;
    left: 5vw;
    right: 5vw;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;
    font-size: 11px;
  }
  .galaxy-controls button {
    color: inherit;
    border: 1px solid #d9c5ec77;
    background: #151020b0;
    padding: 10px 14px;
    border-radius: 30px;
    cursor: pointer;
  }
  .galaxy-controls p {
    margin: 0;
    text-shadow: 0 2px 8px #000;
  }
  .galaxy-index {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    padding: 2.5rem 5vw;
    font-size: 0.8rem;
  }
  .galaxy-index span {
    opacity: 0.6;
  }
  .galaxy-index a {
    color: inherit;
  }
  @keyframes trace-star {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes reveal-star {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 700px) {
    .galaxy {
      height: calc(100svh - 68px);
      min-height: 650px;
    }
    .galaxy-title {
      top: 24px;
      left: 6vw;
    }
    .galaxy-title p {
      margin-top: 22px;
    }
    .galaxy-title h1 {
      font-size: 2.8rem;
    }
    .star:nth-child(1) {
      --x: 20% !important;
      --y: 48% !important;
    }
    .star:nth-child(2) {
      --x: 80% !important;
      --y: 42% !important;
    }
    .star:nth-child(3) {
      --x: 22% !important;
      --y: 77% !important;
    }
    .star:nth-child(4) {
      --x: 80% !important;
      --y: 70% !important;
    }
    .star-reveal {
      width: 230px;
    }
    .star-reveal svg {
      width: 230px;
    }
    .star-card {
      width: 175px;
    }
    .star-card img {
      height: 90px;
    }
    .star-card strong {
      font-size: 16px;
    }
    .star-trigger span {
      font-size: 10px;
    }
    .galaxy-controls {
      left: 6vw;
      right: 6vw;
      font-size: 10px;
    }
    .galaxy-controls p {
      max-width: 150px;
    }
    .galaxy-index {
      gap: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .star-reveal path,
    .star-card {
      animation: none;
    }
    .star-trigger i,
    .star-trigger::after {
      transition: none;
    }
  }
</style>
