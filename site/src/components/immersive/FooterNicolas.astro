---
import { site } from '../../config/site';
---

<div id="footer-nicolas" class="footer-nicolas" data-footer-nicolas data-state="waiting">
  <div class="footer-nicolas-stage" aria-hidden="true">
    <div class="footer-nicolas-actor" data-footer-actor></div>
  </div>
  <div class="footer-nicolas-contact">
    <span class="footer-nicolas-caption">La suite, ensemble.</span>
    <span class="footer-nicolas-dont-click" aria-hidden="true">DON'T CLICK</span>
    <a href={`mailto:${site.email}`} class="footer-nicolas-email">{site.email}</a>
  </div>
  <span class="footer-nicolas-ledge" aria-hidden="true"></span>
</div>

<script>
  import { initFooterNicolas } from '../../lib/footer-nicolas';
  initFooterNicolas();
  document.addEventListener('astro:page-load', initFooterNicolas);
</script>

<style is:global>
  .footer-nicolas {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 290px;
    gap: 10px;
    margin-top: 16px;
    padding-bottom: 38px;
    background: var(--color-paper);
  }

  .footer-nicolas-stage {
    position: relative;
    flex: 0 0 230px;
    width: 230px;
    height: 250px;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .footer-nicolas-actor { position: absolute; inset: 0; }

  .footer-nicolas-pose {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform-origin: 50% 100%;
    pointer-events: none;
  }

  .footer-nicolas-pose img {
    position: absolute;
    max-width: none;
    max-height: none;
    pointer-events: none;
  }

  .footer-nicolas-contact {
    position: relative;
    z-index: 2;
    align-self: flex-end;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding-bottom: 92px;
  }

  .footer-nicolas-caption {
    color: var(--color-ink-soft);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .footer-nicolas-email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.8vw, 2.5rem);
    text-decoration: none;
    text-underline-offset: 7px;
    overflow-wrap: anywhere;
  }

  .footer-nicolas-email:hover { text-decoration: underline; }
  .footer-nicolas-email:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }

  .footer-nicolas-dont-click,
  .mind-footer-launcher-sign {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    padding: 0.28rem 0.48rem 0.22rem;
    border: 1px solid currentColor;
    color: var(--color-accent, #d98258);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.56rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    transform: rotate(-3deg);
  }

  .footer-nicolas-dont-click {
    align-self: flex-start;
    margin-bottom: -2px;
    opacity: 0.88;
  }

  .footer-nicolas-ledge {
    position: absolute;
    right: 0;
    bottom: 38px;
    left: 0;
    z-index: 3;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--color-ink) 38%, transparent) 12%,
      color-mix(in srgb, var(--color-ink) 38%, transparent) 88%,
      transparent
    );
  }

  @media (max-width: 600px) {
    .footer-nicolas { min-height: 235px; gap: 0; padding-bottom: 30px; }
    .footer-nicolas-stage { flex-basis: 140px; width: 140px; height: 200px; }
    .footer-nicolas-actor { width: 230px; height: 250px; inset: auto auto 0 -22px; zoom: 0.8; }
    .footer-nicolas-contact { padding-bottom: 63px; }
    .footer-nicolas-caption { font-size: 0.56rem; letter-spacing: 0.08em; }
    .footer-nicolas-email { font-family: inherit; font-size: clamp(0.8rem, 3.4vw, 1.1rem); }
    .footer-nicolas-ledge { bottom: 30px; }
  }
</style>
