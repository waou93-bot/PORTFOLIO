---
const projects = [
  {
    title: 'Down Trigger',
    meta: 'Musique · signal',
    href: '/work/down-trigger',
    src: '/media/projects/down-trigger/cover-v2.webp',
    alt: 'Down Trigger en contre-plongée dans un décor brutaliste.',
  },
  {
    title: 'Héritage 2',
    meta: 'Patrimoine · matière',
    href: '/work/heritage-2',
    src: '/media/projects/heritage-2/cover-v2.webp',
    alt: 'Escalier en pierre claire baigné de lumière naturelle.',
  },
  {
    title: 'Atelier NØR',
    meta: 'Architecture · espace',
    href: '/work/maison-sillon',
    src: '/media/projects/maison-sillon/cover-v3.webp',
    alt: 'Maison Sillon, volume bas en pierre claire longeant un bassin dans la lumière du soir.',
  },
  {
    title: 'Vantel',
    meta: 'Mode · contraste',
    href: '/work/vantel',
    src: '/media/projects/vantel/cover.webp',
    alt: 'Campagne Vantel DayShift devant une façade minérale.',
  },
];

const heroReelClips = [
  { src: '/media/identity/hero-reel-mirror/clip-01.mp4', ratio: 0.18 },
  { src: '/media/identity/hero-reel-mirror/clip-02.mp4', ratio: 0.18 },
  { src: '/media/identity/hero-reel-mirror/clip-03.mp4', ratio: 0.18 },
  { src: '/media/identity/landing-hero-video.mp4', ratio: 0.1, invert: true },
  { src: '/media/identity/91744-636709154_medium.mp4', ratio: 0.1 },
  { src: '/media/identity/165208-832102298_medium.mp4', ratio: 0.1 },
];

const portraitSrc = '/media/identity/nicolas-jez-hero-bomber-v1-alpha.png';
---

<section class="mind" data-inside-mind data-state="loading" aria-labelledby="mind-title">
  <div class="mind-loader" data-mind-loader role="status" aria-live="polite">
    <div class="mind-loader-logo" aria-label="Nicolas Jez">
      <img src="/media/identity/logo-clair.png" alt="Nicolas Jez" width="1199" height="1312" />
      <span aria-hidden="true"></span>
    </div>
    <span class="mind-loader-bridge" aria-hidden="true"></span>
    <p class="mind-loader-mark">PORTFOLIO · 2026</p>
    <p class="mind-loader-title">Tout commence par une vision.</p>
    <div class="mind-loader-progress" aria-hidden="true">
      <span data-mind-loader-bar></span>
    </div>
    <p class="mind-loader-value"><span data-mind-loader-value>0</span>%</p>
    <button class="mind-loader-skip" type="button" data-mind-loader-skip>Passer</button>
  </div>
  <noscript
    ><style>
      .mind-loader {
        display: none;
      }
    </style></noscript
  >

  <div class="mind-stage">
    <button
      class="mind-footer-launcher"
      type="button"
      data-mind-footer-launcher
      aria-label="Faire tomber Nicolas et voir les coordonnées"
    >
      <span class="mind-footer-launcher-character" aria-hidden="true"></span>
      <span class="mind-footer-launcher-sign" aria-hidden="true">DON'T CLICK</span>
    </button>
    <div class="mind-hero-reel" data-hero-reel aria-hidden="true">
      {heroReelClips.map((clip, index) => (
        <div
          class="mind-hero-pair"
          data-hero-pair
          data-clip-index={index}
          data-cut-ratio={clip.ratio}
          data-invert={clip.invert ? 'true' : undefined}
        >
          <video
            class="mind-hero-video mind-hero-video--source"
            data-mind-hero-video
            data-mirror-side="source"
            src={clip.src}
            muted
            playsinline
            preload={index === 0 ? 'auto' : 'none'}
            tabindex="-1"
          />
          <video
            class="mind-hero-video mind-hero-video--mirror"
            data-mind-hero-video
            data-mirror-side="mirror"
            src={clip.src}
            muted
            playsinline
            preload={index === 0 ? 'auto' : 'none'}
            tabindex="-1"
          />
        </div>
      ))}
    </div>
    <img
      class="mind-portrait"
      src={portraitSrc}
      alt="Nicolas Jez en bomber noir et lunettes de soleil."
      width="1024"
      height="1536"
      fetchpriority="high"
      data-mind-portrait
      data-composite-portrait
    />
    <img
      class="mind-portrait-echo"
      src={portraitSrc}
      alt=""
      width="1672"
      height="941"
      aria-hidden="true"
    />
    <img
      class="mind-portrait-chroma mind-portrait-chroma--cyan"
      src={portraitSrc}
      alt=""
      width="1024"
      height="1536"
      aria-hidden="true"
    />
    <img
      class="mind-portrait-chroma mind-portrait-chroma--red"
      src={portraitSrc}
      alt=""
      width="1024"
      height="1536"
      aria-hidden="true"
    />

    <img class="mind-portrait-half" data-portrait-half alt="" aria-hidden="true" width="1672" height="941" />
    <img class="mind-portrait-half" data-portrait-half alt="" aria-hidden="true" width="1672" height="941" />
    <canvas class="mind-canvas" data-mind-canvas aria-hidden="true"></canvas>
    <video
      class="mind-flight"
      data-mind-flight
      src="/media/transition/drone-journey-source-v1.mp4"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"></video>
    <video
      class="mind-clouds"
      data-mind-clouds
      src="/media/transition/drone-journey-source-v1.mp4"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"></video>
    <video
      class="mind-clouds"
      data-mind-clouds-alt
      src="/media/transition/drone-journey-source-v1.mp4"
      muted
      playsinline
      preload="none"
      aria-hidden="true"></video>
    <div class="mind-vignette" aria-hidden="true"></div>

    <div class="mind-copy" data-mind-copy>
      <div class="mind-identity">
        <p class="mind-name">Nicolas Jez</p>
        <p class="mind-role" data-loupe-exclude>Direction artistique · Design d’expériences numériques</p>
      </div>
      <h1 id="mind-title" class="mind-title" data-loupe-target>Tout commence<br />par une <em>vision.</em></h1>
    </div>

    <div class="mind-actions" data-mind-actions>
      <button class="mind-enter" type="button" data-mind-enter>
        <span class="mind-enter-inner">
          <span class="mind-enter-label">Voir mon univers</span>
        </span>
      </button>
    </div>

    <button class="mind-skip-playing" type="button" data-mind-skip-playing hidden>
      Passer l’introduction
    </button>

    <div class="mind-world" data-mind-world aria-hidden="true">
      <div class="mind-world-head">
        <p class="mind-world-kicker">Inside my mind · choisir un territoire</p>
        <h2 class="mind-world-title" data-mind-world-title tabindex="-1">
          Une idée.<br /><em>Quatre formes.</em>
        </h2>
        <p class="mind-world-intro">Chaque fragment ouvre une étude de cas complète.</p>
      </div>

      <nav class="mind-projects" aria-label="Accès direct aux projets" data-flip-projects data-projects={JSON.stringify(projects)}>
        {
          projects.map((project, index) => (
            <a class:list={['mind-project', `mind-project--${index + 1}`]} href={project.href} aria-label={`Découvrir ${project.title}`} data-project-index={index}>
              <span class="mind-project-face">
              <img src={project.src} alt="" loading="lazy" decoding="async" style={index === 0 ? 'object-position: center 72%' : undefined} />
              <span class="mind-project-shade" aria-hidden="true" />
              <span class="mind-project-copy">
                <span class="mind-project-index">0{index + 1}</span>
                <span class="mind-project-name">{project.title}</span>
                <span class="mind-project-meta">{project.meta}</span>
              </span>
              </span>
            </a>
          ))
        }
      </nav>

      <div class="mind-project-controls">
        <button type="button" data-flip-pause aria-pressed="false">Mettre les palettes en pause</button>
        <nav aria-label="Tous les projets">
          {projects.map(project => <a href={project.href}>{project.title}</a>)}
        </nav>
      </div>

      <button class="mind-reset" type="button" data-mind-reset>Revenir au portrait</button>
    </div>

    <p class="sr-only" aria-live="polite" data-mind-status></p>
  </div>

  <div class="mind-rail" aria-hidden="true">
    <span>Portrait</span>
    <span class="mind-rail-line"></span>
    <span>Portail</span>
    <span class="mind-rail-line"></span>
    <span>Œuvres</span>
  </div>
</section>

<script>
  import { initInsideMindHero } from '../../lib/inside-mind';

  const boot = () => initInsideMindHero();
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style>
  .mind {
    --lens-x: 50%;
    --lens-y: 32.5%;
    position: relative;
    min-height: 100svh;
    overflow: clip;
    color: #f6efe8;
    background: #090b12;
    isolation: isolate;
  }

  .mind-stage {
    position: relative;
    min-height: 100svh;
    overflow: clip;
  }

  .mind-footer-launcher {
    position: absolute;
    z-index: 8;
    top: calc(50% + 2.1rem);
    /* Stay attached to the title block after the portrait makes room on the
       right; the falling figure should not drift toward the video. */
    left: calc(50% + 5.7rem);
    width: 204px;
    height: 264px;
    padding: 0;
    border: 0;
    color: #f5eee8;
    background: transparent;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform-origin: 50% 88%;
    transition: opacity 240ms ease, visibility 240ms ease;
  }

  .mind[data-state='portrait'] .mind-footer-launcher {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mind[data-launcher-entry='waiting'] .mind-footer-launcher {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .mind[data-launcher-entry='falling'] .mind-footer-launcher {
    animation: mind-launcher-entry 1.2s cubic-bezier(0.22, 1, 0.36, 1) both;
    pointer-events: none;
  }

  .mind[data-launcher-entry='falling'] .mind-footer-launcher-character {
    animation: none;
  }

  .mind-footer-launcher-character {
    position: absolute;
    top: -12px;
    left: 12px;
    width: 106px;
    height: 260px;
    background-image: url('/media/footer/nicolas-hanging-fall-v8-alpha.png');
    background-repeat: no-repeat;
    background-size: 900% 100%;
    background-position: 0 0;
    transform-origin: 50% 7%;
    transition: transform 120ms steps(2, end);
  }

  .mind-footer-launcher[data-launcher-pose='1'] .mind-footer-launcher-character { background-position: 12.5% 0; }
  .mind-footer-launcher[data-launcher-pose='2'] .mind-footer-launcher-character { background-position: 25% 0; }
  .mind-footer-launcher[data-launcher-pose='3'] .mind-footer-launcher-character { background-position: 37.5% 0; }
  .mind-footer-launcher[data-launcher-pose='4'] .mind-footer-launcher-character { background-position: 50% 0; }
  .mind-footer-launcher[data-launcher-pose='5'] .mind-footer-launcher-character { background-position: 62.5% 0; }
  .mind-footer-launcher[data-launcher-pose='6'] .mind-footer-launcher-character { background-position: 75% 0; }
  .mind-footer-launcher[data-launcher-pose='7'] .mind-footer-launcher-character { background-position: 87.5% 0; }
  .mind-footer-launcher[data-launcher-pose='8'] .mind-footer-launcher-character { background-position: 100% 0; }
  .mind-footer-launcher[data-launcher-beat='1'] .mind-footer-launcher-character { transform: translateY(-2px) rotate(-2deg); }
  .mind-footer-launcher[data-launcher-beat='2'] .mind-footer-launcher-character { transform: translateY(1px) rotate(2deg); }

  .mind[data-state='portrait'] .mind-footer-launcher-character {
    animation: mind-launcher-hang 1.8s steps(3, end) infinite;
  }

  .mind-footer-launcher-sign {
    position: absolute;
    top: 92px;
    left: 104px;
    z-index: 2;
    padding: 0.36rem 0.54rem 0.4rem;
    border: 1px solid rgba(16, 18, 18, 0.36);
    border-radius: 3px;
    white-space: nowrap;
    color: #151718;
    background: rgba(249, 241, 231, 0.96);
    box-shadow: 3px 4px 0 rgba(4, 6, 7, 0.28), 0 8px 18px rgba(0, 0, 0, 0.18);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    transform: rotate(4deg);
  }

  .mind-footer-launcher-sign::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 18%;
    width: 1px;
    height: 17px;
    background: currentColor;
    opacity: 0.72;
    transform: rotate(-7deg);
    transform-origin: top;
  }

  .mind-footer-launcher:focus-visible {
    outline: 1px solid rgba(245, 238, 232, 0.74);
    outline-offset: 8px;
  }

  .mind[data-footer-launch='falling'] .mind-footer-launcher {
    pointer-events: none;
  }

  .mind[data-footer-launch='done'] .mind-footer-launcher {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .mind[data-footer-launch='falling'] .mind-footer-launcher-character {
    animation: none;
    transform-origin: 50% 56%;
  }

  @keyframes mind-launcher-hang {
    0%, 100% { transform: rotate(-1.1deg); }
    50% { transform: rotate(1.1deg); }
  }

  @keyframes mind-launcher-entry {
    0% { opacity: 0; visibility: visible; transform: translateY(-115vh) rotate(-8deg); }
    82% { opacity: 1; transform: translateY(0) rotate(0); }
    100% { opacity: 1; visibility: visible; transform: translateY(0) rotate(0); }
  }


  .mind-loader {
    position: fixed;
    z-index: calc(var(--z-skip) - 1);
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1rem;
    color: #f5eee8;
    background:
      radial-gradient(circle at 50% 45%, rgba(164, 59, 28, 0.14), transparent 24%), #070707;
  }

  .mind-loader[hidden] {
    display: none;
  }

  .mind-loader-logo {
    position: relative;
    width: min(13rem, 42vw);
    aspect-ratio: 1199 / 1312;
    margin-bottom: 0.5rem;
    overflow: hidden;
    animation: loader-logo-breathe 3.2s 1.8s ease-in-out infinite;
  }

  .mind-loader-logo img,
  .mind-loader-logo span {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .mind-loader-logo img {
    opacity: 0;
    transform: scale(1.04);
    animation: loader-logo-reveal 1.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .mind-loader-logo span {
    width: 18%;
    left: 0;
    right: auto;
    left: -6%;
    background: linear-gradient(90deg, transparent, #d98258 42%, transparent);
    filter: blur(0.25rem);
    opacity: 0;
    transform: translateX(-120%);
    animation: loader-logo-pen 1.75s 0.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .mind-loader-bridge {
    position: absolute;
    left: 50%;
    top: 57.5%;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #d98258 18%, #f5eee8 50%, #d98258 82%, transparent);
    box-shadow: 0 0 1.5rem rgba(217, 130, 88, 0.28);
    opacity: 0;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .mind-loader[data-exit='ink'] .mind-loader-bridge {
    animation: loader-ink-bridge 0.72s 0.04s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .mind-loader-mark,
  .mind-loader-value,
  .mind-loader-skip {
    font-size: 0.64rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245, 238, 232, 0.6);
  }

  .mind-loader-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 3.8rem);
    letter-spacing: -0.035em;
  }

  .mind-loader-progress {
    width: min(16rem, 62vw);
    height: 1px;
    margin-top: 0.5rem;
    overflow: hidden;
    background: rgba(245, 238, 232, 0.16);
  }

  .mind-loader-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #d15e2c, #7faee8);
    transform: scaleX(0);
    transform-origin: left;
  }

  .mind-loader-skip {
    position: absolute;
    right: clamp(1.25rem, 4vw, 3rem);
    bottom: clamp(1.25rem, 4vw, 3rem);
    min-height: 2.75rem;
    color: rgba(245, 238, 232, 0.72);
  }

  @keyframes loader-logo-reveal {
    0% { opacity: 0; clip-path: inset(0 100% 0 0); transform: scale(1.04); }
    12% { opacity: 1; }
    100% { opacity: 1; clip-path: inset(0 0 0 0); transform: scale(1); }
  }

  @keyframes loader-logo-pen {
    0% { opacity: 0; transform: translateX(-120%); }
    12% { opacity: 0.92; }
    88% { opacity: 0.62; }
    100% { opacity: 0; transform: translateX(680%); }
  }

  @keyframes loader-logo-breathe {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-0.16rem); }
  }

  @keyframes loader-ink-bridge {
    0% { width: 0; opacity: 0; }
    18% { opacity: 0.82; }
    78% { opacity: 0.62; }
    100% { width: 74vw; opacity: 0; }
  }

  .mind-hero-video,
  .mind-portrait,
  .mind-portrait-echo,
  .mind-canvas,
  .mind-flight,
  .mind-clouds,
  .mind-vignette {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .mind-hero-reel {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #090b12;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .mind[data-state='playing'] .mind-hero-reel,
  .mind[data-state='revealed'] .mind-hero-reel { opacity: 0; }

  .mind-hero-reel[data-glitch] {
    animation: hero-reel-splice 220ms steps(3, end) both;
  }

  .mind-hero-reel::after {
    content: '';
    position: absolute;
    z-index: 2;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(73, 220, 255, 0.12), transparent 22%, transparent 76%, rgba(255, 92, 116, 0.1)),
      repeating-linear-gradient(0deg, transparent 0 13px, rgba(237, 243, 255, 0.08) 13px 14px, transparent 14px 27px);
    mix-blend-mode: screen;
  }

  .mind-hero-reel[data-glitch]::after {
    animation: hero-reel-glitch-overlay 220ms steps(3, end) both;
  }

  @keyframes hero-reel-splice {
    0%, 100% { transform: none; filter: none; }
    20% { transform: translateX(2px) scale(1.006); filter: saturate(0.72) contrast(1.1); }
    48% { transform: translateX(-3px) scale(1.008); filter: saturate(1.24) contrast(1.06); }
    72% { transform: translateX(1px) scale(1.003); filter: saturate(1.08); }
  }

  @keyframes hero-reel-glitch-overlay {
    0%, 100% { opacity: 0; transform: none; }
    18% { opacity: 0.38; transform: translateX(-2px); }
    44% { opacity: 0.16; transform: translateX(3px) skewX(-0.3deg); }
    68% { opacity: 0.3; transform: translateX(-1px); }
  }

  .mind-hero-video {
    z-index: 0;
    object-fit: cover;
    object-position: center;
    opacity: 1;
    background: #090b12;
    filter: saturate(1.02) contrast(1.02);
    pointer-events: none;
    transition: none;
  }

  .mind-hero-pair {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 1;
  }

  .mind[data-hero-video-ready='true'] .mind-hero-pair[data-active],
  .mind[data-hero-video-ready='true'] .mind-hero-pair[data-incoming] {
    opacity: 1;
  }

  .mind-hero-pair:not([data-active]):not([data-incoming]) {
    opacity: 0;
  }

  .mind-hero-pair[data-incoming] {
    z-index: 1;
    transition: opacity 100ms linear;
  }

  .mind-hero-video--source {
    clip-path: inset(0 50% 0 0);
  }

  .mind-hero-video--mirror {
    /* Select the same left source half, then reflect it across the center. */
    clip-path: inset(0 50% 0 0);
    transform: scaleX(-1);
  }

  /* The Earth clip reads better reversed before its bilateral reflection. */
  .mind-hero-pair[data-invert='true'] .mind-hero-video--source {
    clip-path: inset(0 0 0 50%);
    transform: scaleX(-1);
  }

  .mind-hero-pair[data-invert='true'] .mind-hero-video--mirror {
    clip-path: inset(0 0 0 50%);
    transform: none;
  }

  .mind-portrait {
    object-fit: cover;
    object-position: center;
    transform: translate3d(var(--gaze-x, 0px), var(--gaze-y, 0px), 0);
    transform-origin: var(--lens-x) var(--lens-y);
    transition: filter 70ms ease-out, opacity 520ms ease;
    will-change: transform, opacity, filter;
  }

  .mind[data-hero-video-ready='true'][data-state='portrait'] .mind-portrait-echo {
    opacity: 0;
  }

  .mind[data-state='playing'] .mind-hero-video,
  .mind[data-state='playing'] .mind-portrait {
    opacity: 1;
  }

  .mind[data-state='playing'] .mind-hero-pair,
  .mind[data-state='playing'] .mind-hero-video {
    opacity: 0;
  }

  .mind-portrait-half {
    position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;
    opacity:0;z-index:2;pointer-events:none;filter:saturate(1.04) contrast(1.02);
  }
  .mind[data-rupture] .mind-portrait-half { visibility:hidden; }

  .mind[data-sequence='playing'] .mind-portrait {
    filter: saturate(1.04) contrast(1.02);
  }

  .mind-portrait-echo {
    z-index: 1;
    right: auto;
    width: 52%;
    object-fit: cover;
    object-position: right center;
    opacity: 0.13;
    transform: translate3d(var(--gaze-x, 0px), var(--gaze-y, 0px), 0) scaleX(-1) scale(1.04);
    transform-origin: 50% 38%;
    filter: blur(11px) saturate(0.46) brightness(0.84);
    mask-image: linear-gradient(
      90deg,
      #000 0%,
      rgba(0, 0, 0, 0.92) 18%,
      rgba(0, 0, 0, 0.54) 48%,
      rgba(0, 0, 0, 0.16) 74%,
      transparent 100%
    );
    pointer-events: none;
    will-change: transform, opacity, filter;
    transition:
      opacity 180ms ease-in-out,
      filter 180ms ease-in-out,
      transform 180ms ease-in-out,
      clip-path 180ms ease-in-out;
  }

  .mind[data-split] .mind-portrait-echo {
    --glitch-direction: 1;
    z-index: 2;
    width: 100%;
    opacity: 0.86;
    transform: translateX(0);
    filter: saturate(1.22) contrast(1.06) drop-shadow(5px 0 rgba(65, 205, 255, 0.28))
      drop-shadow(-4px 0 rgba(255, 86, 54, 0.22));
    mask-image: repeating-linear-gradient(
      to bottom,
      #000 0%,
      #000 6%,
      transparent 6.5%,
      transparent 9.5%
    );
    animation: portrait-controlled-glitch var(--glitch-duration, 240ms) steps(4, end) both;
  }

  .mind[data-split='right'] .mind-portrait-echo {
    --glitch-direction: 1;
    clip-path: inset(0 0 0 50%);
  }

  .mind[data-split='left'] .mind-portrait-echo {
    --glitch-direction: -1;
    clip-path: inset(0 50% 0 0);
  }

  @keyframes portrait-controlled-glitch {
    0% {
      transform: translateX(0);
      opacity: 0.35;
    }
    28% {
      transform: translateX(calc(var(--glitch-shift, 6px) * var(--glitch-direction)));
      opacity: 0.9;
    }
    55% {
      transform: translateX(calc(-5px * var(--glitch-direction)));
    }
    78% {
      transform: translateX(calc(3px * var(--glitch-direction)));
    }
    100% {
      transform: translateX(0);
      opacity: 0;
    }
  }

  .mind[data-glitch='tear'] .mind-portrait-echo {
    clip-path: inset(var(--glitch-band-top, 35%) 0 30% 0);
    mask-image: none;
    filter: none;
    animation-name: portrait-tear;
  }

  .mind[data-glitch='slice'] .mind-portrait-echo {
    clip-path: inset(0 34% 0 48%);
    mask-image: linear-gradient(transparent, #000 25%, #000 75%, transparent);
    filter: saturate(0.75);
    animation-name: portrait-slice;
  }

  .mind[data-glitch='chroma'] .mind-portrait-echo {
    clip-path: inset(25% 8% 28% 8%);
    mask-image: linear-gradient(transparent, #000 35%, #000 65%, transparent);
    filter: saturate(1.4);
    animation-name: portrait-chroma;
  }

  @keyframes portrait-tear {
    0%, 100% { transform: translateX(0); opacity: 0; }
    30% { transform: translateX(calc(var(--glitch-shift) * var(--glitch-direction))); opacity: 0.8; }
    65% { transform: translateX(calc(-3px * var(--glitch-direction))); opacity: 0.6; }
  }

  @keyframes portrait-slice {
    0%, 100% { transform: translateY(0); opacity: 0; }
    35% { transform: translateY(-5px); opacity: 0.75; }
    70% { transform: translateY(2px); opacity: 0.45; }
  }

  @keyframes portrait-chroma {
    0%, 100% { transform: translateX(0); opacity: 0; }
    40% { transform: translateX(calc(4px * var(--glitch-direction))); opacity: 0.4; }
    70% { transform: translateX(calc(-2px * var(--glitch-direction))); opacity: 0.25; }
  }

  .mind-stage::after {
    content: '';
    position: absolute;
    z-index: 3;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 3px;
    opacity: 0;
    background: linear-gradient(
      transparent 8%,
      rgba(90, 212, 255, 0.62) 34%,
      rgba(255, 111, 74, 0.5) 68%,
      transparent 92%
    );
    pointer-events: none;
    transition: opacity 180ms ease-in-out;
  }

  .mind[data-glitch='bands'] .mind-stage::after {
    opacity: 0.72;
    animation: glitch-seam var(--glitch-duration, 240ms) steps(3, end) both;
  }

  @keyframes glitch-seam {
    0%,
    100% {
      translate: 0;
    }
    33% {
      translate: 5px 0;
    }
    66% {
      translate: -3px 0;
    }
  }

  .mind-canvas {
    opacity: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* A short signal rupture; the real interface remains responsive. */
  .mind[data-rupture] .mind-stage {
    transform-origin: center;
    animation: entry-signal-fault 720ms steps(5, end) both;
  }

  .mind[data-rupture] .mind-portrait-echo {
    width: 100%;
    z-index: 4;
    opacity: 0;
    transform: none;
    filter: saturate(1.1) drop-shadow(14px 0 #61dfff66) drop-shadow(-12px 0 #f07c6066);
    mask-image: repeating-linear-gradient(to bottom, #000 0 8%, transparent 8% 13%, #000 13% 17%, transparent 17% 29%);
    clip-path: inset(0);
    transition: none;
    animation: entry-signal-tear 720ms steps(5, end) both;
  }

  .mind[data-rupture] .mind-copy {
    animation: entry-type-fault 720ms steps(5, end) both;
  }

  @keyframes entry-signal-fault {
    0%, 12%, 100% { transform: none; filter: none; }
    20% { transform: translate(-8px, 2px) skewX(0.8deg); filter: saturate(0.78) contrast(1.12); }
    38% { transform: translate(11px, -3px) skewX(-1deg); filter: saturate(0.72) contrast(1.16); }
    56% { transform: translate(-5px, 3px); filter: saturate(0.82) contrast(1.08); }
    74% { transform: translate(4px, -1px); filter: saturate(0.92) contrast(1.04); }
    88% { transform: translate(-2px, 0); filter: none; }
  }

  @keyframes entry-signal-tear {
    0%, 12%, 100% { opacity: 0; transform: none; }
    20% { opacity: 0.86; transform: translate(22px, -3px); mask-position: 0 0; }
    38% { opacity: 0.72; transform: translate(-26px, 5px); mask-position: 0 22px; }
    56% { opacity: 0.68; transform: translate(16px, -4px); mask-position: 0 -18px; }
    72% { opacity: 0.38; transform: translate(-8px, 2px); }
    88% { opacity: 0.12; transform: translate(3px, 0); }
  }

  @keyframes entry-type-fault {
    0%, 16%, 76%, 100% { text-shadow: none; }
    24%, 52% { text-shadow: 8px 0 #61dfff88, -7px 0 #f07c6088; }
    38%, 66% { text-shadow: -5px 0 #61dfff66, 6px 0 #f07c6066; }
  }

