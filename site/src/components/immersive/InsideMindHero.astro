  /* Radial-glow treatment adapted from Uiverse.io by Spacious74. */
  .mind-enter {
    --glow-x: 50%;
    --glow-y: 50%;
    position: relative;
    isolation: isolate;
    min-height: 4.15rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.48);
    border-radius: 16px;
    color: #fff;
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.12), rgba(15, 17, 17, 0.28));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -2px 0 rgba(0, 0, 0, 0.24),
      0 4px 0 rgba(8, 10, 10, 0.35), 0 10px 22px rgba(0, 0, 0, 0.2);
    text-transform: uppercase;
    letter-spacing: 0.11em;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
      color 250ms ease,
      box-shadow 250ms ease;
  }

  .mind-enter::before,
  .mind-enter::after {
    content: '';
    position: absolute;
    pointer-events: none;
    transition: opacity 250ms ease;
  }

  .mind-enter::before {
    z-index: 2;
    inset: -1px;
    padding: 1px;
    border-radius: 16px;
    opacity: 0;
    background: radial-gradient(
      circle 82px at var(--glow-x) var(--glow-y),
      #d9fbff 0%,
      #3fe9ff 32%,
      rgba(0, 81, 255, 0.55) 58%,
      transparent 78%
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
  }

  .mind-enter::after {
    z-index: -1;
    inset: -12px;
    border-radius: 24px;
    opacity: 0;
    background: radial-gradient(
      circle 68px at calc(var(--glow-x) + 12px) calc(var(--glow-y) + 12px),
      rgba(63, 233, 255, 0.42),
      rgba(0, 81, 255, 0.16) 48%,
      transparent 76%
    );
    filter: blur(8px);
  }

  .mind-enter:hover {
    transform: translateY(-2px);
    color: #d9fbff;
  }

  .mind-enter:active {
    transform: translateY(3px) scale(0.96);
    box-shadow: inset 0 1px 4px rgba(0, 0, 0, 0.22),
      0 1px 0 rgba(8, 10, 10, 0.35), 0 4px 12px rgba(0, 0, 0, 0.16);
  }

  .mind-enter:active .mind-enter-inner {
    transform: translateY(1px);
  }

  .mind-enter:hover::before,
  .mind-enter:hover::after,
  .mind-enter:focus-visible::before,
  .mind-enter:focus-visible::after {
    opacity: 1;
  }

  .mind-enter:focus-visible {
    outline: 2px solid #3fe9ff;
    outline-offset: 4px;
  }

  .mind-enter-inner {
    position: relative;
    z-index: 1;
    min-height: calc(4.15rem - 2px);
    padding: 0.9rem 1.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 15px;
    background: transparent;
  }

  .mind-enter-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle 72px at var(--glow-x) var(--glow-y),
      rgba(0, 225, 255, 0.16),
      rgba(0, 0, 255, 0.07) 48%,
      transparent 76%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms ease;
  }

  .mind-enter:hover .mind-enter-inner::before,
  .mind-enter:focus-visible .mind-enter-inner::before {
    opacity: 1;
  }

  @keyframes mind-energy-gather {
    0%, 100% { transform: translate(0.6rem, -0.2rem) scale(1.08) rotate(-5deg); opacity: 0.22; }
    48% { transform: translate(-0.3rem, 0.1rem) scale(0.92) rotate(4deg); opacity: 0.62; }
    72% { transform: translate(0.2rem, 0) scale(0.98) rotate(1deg); opacity: 0.36; }
  }

