      radial-gradient(ellipse 7rem 0.42rem at 85% 63%, rgba(217, 251, 255, 0.24), transparent 72%),
      radial-gradient(ellipse 3.5rem 0.32rem at 73% 10%, rgba(63, 233, 255, 0.26), transparent 74%),
