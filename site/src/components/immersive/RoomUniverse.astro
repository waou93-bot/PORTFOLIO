---
import { ROOM_IMAGE } from '../../lib/room-preload';
import { getPublishedProjects } from '../../lib/content';
const published = await getPublishedProjects();
const positions = [
  [58, 62],
  [81, 35],
  [64, 16],
  [17, 84],
  [20, 49],
];
const projects = published.map((p, i) => ({
  slug: p.data.slug,
  name: p.data.title,
  image: p.data.cover.src.replace('/media/projects/', ''),
  detail: 'Site en ligne',
  x: positions[i]?.[0] ?? 50,
  y: positions[i]?.[1] ?? 50,
}));
---

<section class="room" data-room aria-label="L’atelier des projets">
  <header class="room-heading">
    <a href="/">Retour au portrait</a><h1>Suivez votre <em>curiosité.</em></h1><p>
      Cinq objets, cinq sites en ligne. <a class="room-other-projects" href="/autres-projets"
        >Mes autres projets</a
      >
    </p>
  </header>
  <div class="room-scene">
    <div class="room-art" aria-hidden="true">
      <img
        class="room-base"
        src={ROOM_IMAGE}
        srcset="/media/atelier/atelier-pixel-rgb-840.webp 840w, /media/atelier/atelier-pixel-rgb-1680.webp 1680w"
        sizes="100vw"
        width="1672"
        height="941"
        alt=""
        loading="eager"
        fetchpriority="high"
      />
      <img
        class="room-echo"
        src={ROOM_IMAGE}
        srcset="/media/atelier/atelier-pixel-rgb-840.webp 840w, /media/atelier/atelier-pixel-rgb-1680.webp 1680w"
        sizes="100vw"
        width="1672"
        height="941"
        alt=""
      />
      <div class="room-light"></div>
    </div>
    {
      projects.map((p, i) => (
        <div
          class:list={['room-point', { 'toward-left': p.x > 50, 'toward-bottom': p.y < 40 }]}
          style={`--x:${p.x}%;--y:${p.y}%`}
          data-project={p.slug}
          data-room-point
        >
          <button
            class="room-trigger"
            aria-label={`Découvrir ${p.name}`}
            aria-expanded="false"
            aria-controls={`room-card-${i}`}
          >
            <span aria-hidden="true">0{i + 1}</span>
          </button>
          <div class="room-reveal" id={`room-card-${i}`} hidden>
            <svg class="room-connector" viewBox="0 0 250 60" aria-hidden="true">
              <path d="M 0 59 L 50 1 H 250" pathLength="1" />
            </svg>
            <a href={`/work/${p.slug}`} class="room-card">
              <>
                <div class="room-preview">
                  <img
                    src={`/media/projects/${p.image}`}
                    width="400"
                    height="250"
                    alt=""
                    loading="eager"
                    decoding="async"
                  />
                </div>
                <div class="room-card-copy">
                  <>
                    <small>{p.detail}</small>
                    <strong>{p.name}</strong>
                    <span>Voir le projet</span>
                  </>
                </div>
              </>
            </a>
            <button class="room-close" type="button" aria-label={`Fermer ${p.name}`}>
              <span aria-hidden="true">×</span>
            </button>
          </div>
        </div>
      ))
    }
  </div>
  <div class="room-controls">
    <p>Explorez les repères sur les objets.</p><button
      data-room-pause
      type="button"
      aria-pressed="false">Mettre les effets en pause</button
    >
  </div>
  <nav class="room-index" aria-label="Accès direct aux projets">
    {
      projects.map((p, i) => (
        <a href={`/work/${p.slug}`}>
          <small>0{i + 1}</small> {p.name}
        </a>
      ))
    }
  </nav>
</section>
<script>
  import { initRoom } from '../../lib/room-universe';
  initRoom();
  document.addEventListener('astro:page-load', initRoom);
</script>
<style>
  :global(.page-shell:has(.room) .brand-logo) {
    filter: brightness(0) invert(1);
  }
  :global(.page-shell:has(.room-point[data-promoted='true']) .site-header) {
    visibility: hidden;
  }
  .room {
    background: #0b0b0e;
    color: #f4f0e9;
    min-height: 85svh;
    padding-top: var(--header-h);
    --room-accent: #9ce6ff;
  }
  .room-heading {
    padding: 32px 5vw 28px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px 32px;
    align-items: end;
  }
  .room-heading > a {
    grid-column: 1/-1;
    font-size: 12px;
    color: #bcbcc4;
    width: fit-content;
  }
  .room-heading h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: 0;
  }
  .room-heading h1 em {
    color: var(--room-accent);
  }
  .room-heading p {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: #bcbcc4;
    max-width: 30ch;
  }
  .room-heading p a {
    color: #f4f0e9;
    display: block;
  }
  .room-scene {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1672/941;
    max-width: 1600px;
    margin: auto;
  }
  .room-art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .room-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .room-echo,
  .room-light {
    opacity: 0;
  }
  .room-light {
    position: absolute;
    inset: 0;
    background: #8adfff;
    mix-blend-mode: soft-light;
  }
  .room[data-anomaly='band'] .room-echo {
    clip-path: inset(38% 0 50%);
    animation: room-band 1.1s ease-in-out both;
  }
  .room[data-anomaly='reflection'] .room-echo {
    clip-path: inset(0 0 0 65%);
    animation: room-band 1.1s ease-in-out both;
  }
  .room[data-anomaly='light'] .room-light {
    animation: room-light 1.8s ease both;
  }
  .room-point {
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: 2;
  }
  .room-point[data-open='true'] {
    z-index: 5;
  }
  .room-point[data-promoted='true'] {
    z-index: 20;
  }
  .room-trigger {
    position: absolute;
    left: -24px;
    top: -24px;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    cursor: pointer;
    color: #fff;
  }
  .room-trigger span {
    transition: background-color 180ms ease, color 180ms ease, transform 240ms ease;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid #b2eaff;
    background: #11131fea;
    font: 12px monospace;
    box-shadow: 3px 3px 0 #11131f;
  }
  .room-trigger:hover span,
  .room-trigger[aria-expanded='true'] span {
    color: #0b0b0e;
    background: var(--room-accent);
  }
  .room-trigger:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .room-reveal {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 290px;
    padding-bottom: 52px;
    pointer-events: none;
  }
  .room-reveal[hidden] {
    display: none;
  }
  .room-connector {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 290px;
    height: 54px;
    pointer-events: none;
  }
  .room-connector path {
    fill: none;
    stroke: #b2eaff;
    stroke-width: 1.5;
  }
  .room-card {
    display: block;
    width: 240px;
    margin-left: 50px;
    background: #111318;
    border: 1px solid #494d57;
    color: #f4f0e9;
    pointer-events: auto;
    text-decoration: none;
  }
  .room-card .room-preview {
    position: relative;
    padding: 0;
    min-width: 0;
    background: #08090c;
    height: 200px;
  }
  .room-card img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .room-card-copy {
    display: grid;
    gap: 8px;
    padding: 16px;
  }
  .room-card small {
    color: #aeb3be;
    font-size: 11px;
  }
  .room-card strong {
    font-size: 21px;
    font-weight: 500;
    line-height: 1.15;
  }
  .room-card span {
    font-size: 12px;
    color: var(--room-accent);
  }
  .room-card:focus-visible {
    outline: 2px solid var(--room-accent);
    outline-offset: 3px;
  }
  .room-close {
    display: none;
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    pointer-events: auto;
    width: 36px;
    height: 36px;
    place-items: center;
    background: #101218;
    color: #fff;
    border: 1px solid #808796;
    font-size: 24px;
    cursor: pointer;
  }
  .room-close:focus-visible {
    outline: 2px solid var(--room-accent);
  }
  .toward-left .room-reveal {
    left: auto;
    right: 0;
  }
  .toward-left .room-connector {
    transform: scaleX(-1);
  }
  .toward-left .room-card {
    margin-left: 0;
  }
  .toward-bottom .room-reveal {
    top: 24px;
    bottom: auto;
    padding-bottom: 0;
  }
  .toward-bottom .room-connector {
    display: none;
  }
  .room-point[data-promoted='true']::before {
    content: '';
    position: fixed;
    inset: 0;
    background: #050608b8;
    z-index: -1;
  }
  .room-point[data-promoted='true'] .room-reveal {
    position: fixed;
    top: 50%;
    left: 50%;
    bottom: auto;
    right: auto;
    width: min(88vw, 840px);
    max-height: 86svh;
    overflow: auto;
    padding: 0;
    transform: translate(-50%, -50%);
  }
  .room-point[data-promoted='true'] .room-connector {
    display: none;
  }
  .room-point[data-promoted='true'] .room-close {
    display: grid;
  }
  .room-point[data-promoted='true'] .room-card {
    width: 100%;
    margin: 0;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
  }
  .room-point[data-promoted='true'] .room-preview {
    height: min(64svh, 580px);
  }
  .room-point[data-promoted='true'] .room-card img {
    max-height: 100%;
  }
  .room-point[data-promoted='true'] .room-card-copy {
    align-content: center;
    padding: 32px;
  }
  .room-point[data-promoted='true'] strong {
    font-size: clamp(24px, 3vw, 36px);
  }
  .room-controls {
    padding: 20px 5vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    font-size: 13px;
    color: #bcbcc4;
  }
  .room-controls p {
    margin: 0;
  }
  .room-controls button {
    background: none;
    border: 0;
    border-bottom: 1px solid #6c7280;
    padding: 8px 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .room-index {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 32px;
    padding: 8px 5vw 40px;
  }
  .room-index a {
    color: #f4f0e9;
    font-size: 15px;
    text-decoration: none;
    padding-bottom: 7px;
    border-bottom: 1px solid transparent;
  }
  .room-index a:hover,
  .room-index a:focus-visible {
    border-color: var(--room-accent);
  }
  .room-index small {
    margin-right: 8px;
    color: var(--room-accent);
    font: 11px monospace;
  }
  @keyframes room-band {
    0%,
    100% {
      opacity: 0;
      transform: none;
    }
    30%,
    60% {
      opacity: 0.24;
      transform: translateX(2px);
    }
  }
  @keyframes room-light {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 0.16;
    }
  }
  @media (max-width: 700px) {
    .room {
      padding-top: 11rem;
    }
    .room-heading {
      grid-template-columns: 1fr;
      padding: 28px 6vw;
    }
    .room-heading p {
      max-width: none;
    }
    .room-scene {
      margin-bottom: 24px;
    }
    .room-reveal,
    .toward-left .room-reveal {
      position: fixed;
      top: auto;
      bottom: 16px;
      left: 6vw;
      right: auto;
      width: 88vw;
      padding: 0;
    }
    .room-connector {
      display: none;
    }
    .room-card,
    .toward-left .room-card {
      width: 100%;
      margin: 0;
      display: grid;
      grid-template-columns: 45% 1fr;
    }
    .room-card .room-preview {
      height: 180px;
    }
    .room-card-copy {
      align-content: center;
    }
    .room-point[data-promoted='true'] .room-card {
      grid-template-columns: 1fr;
    }
    .room-point[data-promoted='true'] .room-preview {
      height: 48svh;
    }
    .room-point[data-promoted='true'] .room-card-copy {
      padding: 20px;
    }
    .room-controls {
      align-items: flex-start;
      font-size: 12px;
    }
    .room-index {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    .room-trigger span {
      width: 28px;
      height: 28px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .room-echo,
    .room-light {
      display: none;
    }
  }
</style>
