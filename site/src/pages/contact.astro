---
import BaseLayout from '../components/layout/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Contact"
  description="Parler d'un projet avec Nicolas Jez — direction artistique, UX/UI, landing pages immersives et développement front-end."
>
  <section class="section contact-scene">
    <img class="contact-portrait" src="/media/identity/reveal-v1/portrait-01.webp" alt="" width="1792" height="1024" fetchpriority="high" />
    <div class="container contact-content">
      <SectionHeading
        index="Contact"
        title="Parler d'un projet"
        subtitle="Un site, un SaaS, un outil interne ou de l’IA à intégrer à votre métier : parlons de ce qui vous serait vraiment utile."
      />

      <div class="contact-grid">
        <ContactForm />

        <aside class="contact-side">
          <p class="eyebrow">Contact direct</p>
          <a class="contact-mail" href={`mailto:${site.email}`}>{site.email}</a>
          <p class="meta">{site.location}</p>
          <p class="meta">{site.availability}</p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-scene {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: #b9a38c;
    min-height: 900px;
  }
  .contact-portrait {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% center;
    z-index: -2;
  }
  .contact-scene::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(245, 239, 229, 0.96) 0%, rgba(245, 239, 229, 0.9) 33%, rgba(245, 239, 229, 0.1) 62%, transparent 76%);
  }
  .contact-content { position: relative; }
  .contact-content :global(.section-head) { max-width: 530px; }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    max-width: 530px;
    gap: var(--space-8);
    align-items: start;
  }

  .contact-side {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .contact-mail {
    font-weight: 700;
    font-size: var(--text-lg);
    border-bottom: 1px solid var(--color-line-strong);
  }

  @media (max-width: 48rem) {
    .contact-scene { padding-top: 340px; }
    .contact-portrait { height: 380px; object-position: 75% 30%; }
    .contact-scene::before {
      background: linear-gradient(180deg, transparent 200px, rgba(245, 239, 229, 0.8) 310px, #f5efe5 380px);
    }
    .contact-content :global(.section-head), .contact-grid { max-width: none; }
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }
</style>
