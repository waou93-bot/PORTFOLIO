---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../components/layout/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import ProjectMedia from '../components/media/ProjectMedia.astro';
import { getVisibleProjects, isPublished } from '../lib/content';

const projects = await getVisibleProjects();
const otherProjects = projects.filter((project) => !project.data.featured);
const ongoing = otherProjects.filter((project) => !isPublished(project));
const completed = otherProjects.filter((project) => isPublished(project));
type ProjectItem = CollectionEntry<'projects'>;
const ongoingManualProjects = [
  {
    title: 'Atelier NØR',
    meta: 'Site internet · architecture',
    summary: 'Le nouveau site éditorial du studio, actuellement en cours de finalisation.',
    href: '',
    linkLabel: 'Projet en cours',
  },
  {
    title: 'LookUp',
    meta: 'Application · en développement',
    summary: 'Une application en cours de développement, ajoutée ici comme projet à suivre.',
    href: '',
    linkLabel: 'Projet en cours',
  },
  {
    title: 'HQ Layer',
    meta: 'Projet digital · en développement',
    summary: 'Une nouvelle exploration en cours, à suivre dans cet index.',
    href: '',
    linkLabel: 'Projet en cours',
  },
];
const completedManualProjects = [
  {
    title: 'BEE',
    meta: 'Site internet · réalisé',
    summary: 'Site réalisé pour l’association Beauchamp Ensemble pour les Élèves (validation en cours avant déploiement).',
    href: '',
    linkLabel: 'Nom de domaine et lien à ajouter après déploiement',
  },
];
---

<BaseLayout
  title="Mes autres projets"
  description="Un index simple des projets en cours et aboutis de Nicolas Jez."
  theme="light"
>
  <main class="other-projects-page">
    <section class="other-projects-intro container">
      <p class="eyebrow">Index complémentaire</p>
      <h1>Mes autres <em>projets.</em></h1>
      <p class="intro-copy">
        Les quatre projets principaux restent au cœur de l’expérience. Cette page accueille les
        nouvelles études, les projets en cours et les réalisations à venir, sans modifier le parcours
        principal.
      </p>
      <nav class="other-projects-actions" aria-label="Navigation de la page">
        <a class="btn btn--primary" href="/">Retour à l’accueil</a>
        <a class="btn btn--ghost" href="/univers-v2">Retour aux projets</a>
      </nav>
    </section>

    <div class="other-projects-sections container">
      <section aria-labelledby="ongoing-title">
        <div class="section-heading">
          <p class="eyebrow">01 · En cours</p>
          <h2 id="ongoing-title">À suivre.</h2>
        </div>
        {
          ongoingManualProjects.length > 0 || ongoing.length > 0 ? (
            <div class="project-list">
              {ongoingManualProjects.map((project) => (
                project.href ? (
                  <a class="project-row project-row--manual" href={project.href} target="_blank" rel="noopener noreferrer">
                    <div class="project-row-placeholder" aria-hidden="true"><span>En cours</span></div>
                    <span class="project-row-copy">
                      <span class="project-row-meta"><span>{project.meta}</span><span class="project-status">À suivre</span></span>
                      <strong>{project.title}</strong>
                      <span>{project.summary}</span>
                      <span class="project-row-link">{project.linkLabel}</span>
                    </span>
                  </a>
                ) : (
                  <article class="project-row project-row--manual">
                    <div class="project-row-placeholder" aria-hidden="true"><span>En cours</span></div>
                    <span class="project-row-copy">
                      <span class="project-row-meta"><span>{project.meta}</span><span class="project-status">À suivre</span></span>
                      <strong>{project.title}</strong>
                      <span>{project.summary}</span>
                      <span class="project-row-link">{project.linkLabel}</span>
                    </span>
                  </article>
                )
              ))}
              {ongoing.map((project: ProjectItem) => (
                <a class="project-row" href={`/work/${project.data.slug}`}>
                  <ProjectMedia src={project.data.cover.src} alt={project.data.cover.alt} sizes="(min-width: 48rem) 16rem, 92vw" loading="lazy" />
                  <span class="project-row-copy">
                    <span class="project-row-meta">
                      <span>{project.data.year} · {project.data.sector}</span>
                      <Badge kind={project.data.kind} tone="neutral" />
                    </span>
                    <strong>{project.data.title}</strong>
                    <span>{project.data.summary}</span>
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <p class="empty-state">Les prochains projets en cours apparaîtront ici.</p>
          )
        }
      </section>

      <section aria-labelledby="completed-title">
        <div class="section-heading">
          <p class="eyebrow">02 · Aboutis</p>
          <h2 id="completed-title">Déjà réalisés.</h2>
        </div>
        {
          completedManualProjects.length > 0 || completed.length > 0 ? (
            <div class="project-list">
              {completedManualProjects.map((project) => (
                <article class="project-row project-row--manual">
                  <div class="project-row-placeholder" aria-hidden="true"><span>Réalisé</span></div>
                  <span class="project-row-copy">
                    <span class="project-row-meta"><span>{project.meta}</span><span class="project-status">À valider</span></span>
                    <strong>{project.title}</strong>
                    <span>{project.summary}</span>
                    <span class="project-row-link">{project.linkLabel}</span>
                  </span>
                </article>
              ))}
              {completed.map((project: ProjectItem) => (
                <a class="project-row" href={`/work/${project.data.slug}`}>
                  <ProjectMedia src={project.data.cover.src} alt={project.data.cover.alt} sizes="(min-width: 48rem) 16rem, 92vw" loading="lazy" />
                  <span class="project-row-copy">
                    <span class="project-row-meta">
                      <span>{project.data.year} · {project.data.sector}</span>
                      <Badge kind={project.data.kind} tone="neutral" />
                    </span>
                    <strong>{project.data.title}</strong>
                    <span>{project.data.summary}</span>
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <p class="empty-state">Les projets aboutis ajoutés à l’index apparaîtront ici.</p>
          )
        }
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  @font-face {
    font-family: 'Bebas Neue';
    src: url('/fonts/BebasNeue-Regular.ttf') format('truetype');
    font-display: swap;
    font-style: normal;
    font-weight: 400;
  }

  .other-projects-page {
    min-height: 100svh;
    padding-block: clamp(7rem, 13vw, 11rem) var(--space-9);
    background: var(--color-paper);
    font-family: 'Manrope Variable', var(--font-sans);
  }

  .other-projects-intro {
    display: grid;
    gap: var(--space-4);
    max-width: 52rem;
  }

  h1,
  h2 {
    margin: 0;
    font-family: 'Bebas Neue', var(--font-display);
    font-weight: 400;
    letter-spacing: 0.025em;
    font-style: normal;
  }

  h1 {
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.92;
  }

  h1 em,
  h2 em {
    color: var(--color-accent);
    font-style: italic;
  }

  .intro-copy {
    max-width: 48ch;
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .other-projects-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .other-projects-actions .btn {
    font-family: 'Manrope Variable', var(--font-sans);
  }

  .other-projects-sections {
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
    margin-top: clamp(5rem, 12vw, 10rem);
  }

  .other-projects-sections section {
    display: grid;
    gap: var(--space-5);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: var(--border-1);
    padding-bottom: var(--space-4);
  }

  h2 {
    font-size: clamp(2.75rem, 6vw, 5rem);
    line-height: 0.95;
  }

  .project-list {
    display: grid;
    gap: var(--space-3);
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(12rem, 20rem) 1fr;
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: center;
    border-bottom: var(--border-1);
    padding-block: var(--space-4);
    color: inherit;
    text-decoration: none;
  }

  .project-row :global(img) {
    aspect-ratio: 16 / 10;
    width: 100%;
    border-radius: var(--radius-m);
    object-fit: cover;
  }

  .project-row-placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border: 1px solid color-mix(in oklch, var(--color-accent) 48%, var(--color-ink) 20%);
    border-radius: var(--radius-m);
    background:
      linear-gradient(135deg, transparent 49.7%, color-mix(in oklch, var(--color-accent) 48%, transparent) 50%, transparent 50.3%),
      color-mix(in oklch, var(--color-paper) 92%, var(--color-accent) 8%);
    color: var(--color-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .project-row-copy {
    display: grid;
    gap: var(--space-2);
  }

  .project-row-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .project-row-copy strong {
    font-family: 'Bebas Neue', var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    letter-spacing: 0.025em;
    line-height: 0.95;
  }

  .project-row-copy > span:last-child {
    max-width: 52ch;
    color: var(--color-ink-soft);
    line-height: var(--leading-relaxed);
  }

  .project-row-link {
    color: var(--color-accent);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .project-status {
    color: var(--color-accent);
  }

  .project-row--manual {
    cursor: default;
  }

  .project-row--manual:hover strong,
  .project-row--manual:focus-visible strong {
    color: var(--color-accent);
  }

  .project-row:hover strong,
  .project-row:focus-visible strong {
    color: var(--color-accent);
  }

  .project-row:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }

  .empty-state {
    margin: 0;
    border-left: 2px solid var(--color-accent);
    padding: var(--space-4) var(--space-5);
    color: var(--color-ink-soft);
  }

  @media (max-width: 700px) {
    .other-projects-page {
      padding-top: 6rem;
    }

    .section-heading {
      display: grid;
      align-items: start;
    }

    .project-row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
