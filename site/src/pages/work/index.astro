---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ProjectGrid from '../../components/project/ProjectGrid.astro';
import { getVisibleProjects } from '../../lib/content';
import { itemListLd } from '../../lib/seo';

const projects = await getVisibleProjects();
---

<BaseLayout
  title="Projets"
  description="Projets sélectionnés de Nicolas Jez — direction artistique, UX/UI, landing pages immersives et développement front-end."
  jsonLd={projects.length ? [itemListLd(projects)] : []}
>
  <section class="section">
    <div class="container">
      <SectionHeading
        index="Projets"
        title="Selected Works"
        subtitle="Chaque projet porte son univers. Chaque page documente le travail réel : rôle, périmètre, décisions."
      />

      {
        projects.length > 0 ? (
          <ProjectGrid projects={projects} />
        ) : (
          <div class="empty">
            <p class="display empty-title">Les études de cas arrivent.</p>
            <p class="empty-text">
              Les projets sont en cours de documentation. Revenez bientôt, ou contactez-moi pour
              discuter d'un projet.
            </p>
            <a class="btn btn--primary" href="/contact">
              Parler d'un projet
            </a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .empty {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: var(--container-narrow);
  }

  .empty-title {
    font-size: var(--text-3xl);
  }

  .empty-text {
    color: var(--color-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }
</style>
