---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import ProjectMedia from '../../components/media/ProjectMedia.astro';
import VideoPreview from '../../components/media/VideoPreview.astro';
import NextProject from '../../components/project/NextProject.astro';
import { getVisibleProjects, projectNav, isPublished } from '../../lib/content';
import { creativeWorkLd } from '../../lib/seo';
import { PROJECT_KIND_LABELS, RIGHTS_LABELS } from '../../types/project';

export async function getStaticPaths() {
  const projects = await getVisibleProjects();
  return projects.map((p) => ({ params: { slug: p.data.slug }, props: { project: p } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const allProjects = await getVisibleProjects();
const nav = projectNav(allProjects, p.slug);
const isConcept = p.kind === 'concept' || p.kind === 'redesign' || p.kind === 'experimental';
const disclaimer = p.independentConceptDisclaimer;
const hasResults = p.results.length > 0;
type ProjectData = CollectionEntry<'projects'>['data'];
type ResultItem = ProjectData['results'][number];
type MediaItem = ProjectData['gallery'][number];
---

<BaseLayout
  title={p.seoTitle ?? p.title}
  description={p.seoDescription ?? p.summary}
  theme={p.theme.dark ? 'dark' : 'light'}
  accent={p.theme.accent}
  accentContrast={p.theme.accentContrast}
  ogImage={p.cover.src}
  jsonLd={[creativeWorkLd(project)]}
>
  <article class:list={['project-page', `project-page--${p.slug}`]}>
    <!-- Ouverture visuelle -->
    <section class="project-hero">
      <div class="project-hero-layout container">
        <div class="project-hero-inner">
          <p class="eyebrow reveal">{p.year} · {p.sector}</p>
          <div class="project-title-row">
            <h1 class="project-title display reveal">{p.title}</h1>
            {
              p.liveUrl && (
                <a
                  class="button reveal"
                  href={p.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="button__line" aria-hidden="true"></span>
                  <span class="button__line" aria-hidden="true"></span>
                  <span class="button__text"><span class="button__label">Voir le site en ligne</span></span>
                </a>
              )
            }
          </div>
          <p class="project-summary reveal">{p.summary}</p>
          <div class="project-badges reveal">
            <Badge kind={p.kind} tone={isConcept ? 'neutral' : 'solid'} />
            {isConcept && <span class="meta">Étude indépendante — non commandée</span>}
          </div>
          {
            (p.archivedUrl || !isPublished(project)) && (
              <div class="project-hero-actions reveal">
                {
                  p.archivedUrl && (
                    <a
                      class="btn btn--ghost"
                      href={p.archivedUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Archive visuelle
                    </a>
                  )
                }
                {!isPublished(project) && <span class="meta">Étude en cours de documentation</span>}
              </div>
            )
          }
        </div>
        <img
          class="project-hero-image"
          src={p.cover.src}
          alt={p.cover.alt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          style="position: fixed; z-index: -2; inset: 0; height: 100svh;"
        />
      </div>
    </section>

    {
      disclaimer && (
        <div class="container">
          <aside class="disclaimer reveal" role="note">
            <span class="eyebrow">Mention</span>
            <p>{disclaimer}</p>
          </aside>
        </div>
      )
    }

    {
      p.previewVideo && (
        <section class="project-cover container">
          <VideoPreview
            src={p.previewVideo.src}
            poster={p.previewVideo.poster ?? p.cover.src}
            alt={p.previewVideo.alt}
          />
        </section>
      )
    }

    <!-- Métadonnées -->
    <section class="section section--compact project-facts-section" aria-label="Informations du projet">
      <div class="container">
        <p class="eyebrow project-facts-label">Fiche projet</p>
        <dl class="facts">
          <div class="fact">
            <dt>Rôle</dt>
            <dd>{p.role.join(' · ')}</dd>
          </div>
          <div class="fact">
            <dt>Services</dt>
            <dd>{p.services.join(' · ')}</dd>
          </div>
          <div class="fact">
            <dt>Année</dt>
            <dd>{p.year}</dd>
          </div>
          <div class="fact">
            <dt>Secteur</dt>
            <dd>{p.sector}</dd>
          </div>
          <div class="fact">
            <dt>Statut</dt>
            <dd>{PROJECT_KIND_LABELS[p.kind]}</dd>
          </div>
          <div class="fact">
            <dt>Droits</dt>
            <dd>{RIGHTS_LABELS[p.rightsStatus]}</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Étude de cas -->
    <section class="section section--compact">
      <div class="container-narrow">
        <div class="prose reveal">
          <Content />
        </div>
      </div>
    </section>

    {
      hasResults && (
        <section class="section section--compact" aria-label="Résultats">
          <div class="container-narrow">
            <p class="eyebrow">Résultats</p>
            <div class="results">
              {p.results.map((r: ResultItem) => (
                <div class="result">
                  <p class="result-value display">
                    {r.value} <span class="result-unit">{r.unit}</span>
                  </p>
                  <p class="result-meta meta">
                    Source : {r.source} · {r.date} · {r.confidence}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      p.gallery.length > 0 && (
        <section
          class="section section--compact"
            aria-label="Captures du site"
        >
          <div class="container">
            <p class="eyebrow">Captures du site</p>
            <div class="gallery">
              {p.gallery.map((g: MediaItem) => (
                <figure class="gallery-item reveal">
                  <ProjectMedia
                    src={g.src}
                    alt={g.alt}
                    sizes="(min-width: 48rem) 32rem, 92vw"
                    loading="lazy"
                  />
                  {g.caption && <figcaption class="meta">{g.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      p.mobileGallery.length > 0 && (
        <section class="section section--compact" aria-label="Version mobile">
          <div class="container">
            <p class="eyebrow">Version mobile</p>
            <div class="mobile-gallery">
              {p.mobileGallery.map((g: MediaItem) => (
                <figure class="mobile-item reveal">
                  <ProjectMedia src={g.src} alt={g.alt} sizes="300px" loading="lazy" />
                  {g.caption && <figcaption class="meta">{g.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {nav && <NextProject project={nav.next} />}
  </article>
</BaseLayout>

<style>
  @font-face {
    font-family: 'Bebas Neue';
    src: url('/fonts/BebasNeue-Regular.ttf') format('truetype');
    font-display: swap;
    font-style: normal;
    font-weight: 400;
  }

  @font-face {
    font-family: 'Momo Trust Display';
    src: url('/fonts/MomoTrustDisplay-Regular.ttf') format('truetype');
    font-display: swap;
    font-style: normal;
    font-weight: 400;
  }

  .project-page {
    position: relative;
    isolation: isolate;
    font-family: 'Manrope Variable', var(--font-sans);
    background: transparent;
  }

  .project-page > .section,
  .project-page > .project-cover {
    position: relative;
    background: color-mix(in oklch, var(--color-paper) 74%, transparent);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }

  .project-page .display,
  .project-page .display-italic {
    font-family: 'Bebas Neue', var(--font-sans);
    font-style: normal;
  }

  .project-hero {
    position: relative;
    isolation: isolate;
    min-height: min(86svh, 58rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    color: rgb(255 255 255 / 0.96);
    padding-top: var(--space-9);
    padding-bottom: clamp(1.5rem, 3vw, 3rem);
  }

  .project-hero::before,
  .project-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .project-hero::before {
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.2), transparent 35%, rgb(0 0 0 / 0.78)),
      linear-gradient(90deg, rgb(0 0 0 / 0.72), transparent 68%);
  }

  .project-hero::after {
    z-index: -1;
    background: linear-gradient(180deg, transparent 55%, rgb(0 0 0 / 0.36));
    mix-blend-mode: multiply;
  }

  .project-hero-layout {
    display: contents;
  }

  .project-hero-inner {
    width: min(100% - var(--gutter) * 2, var(--container));
    margin-inline: auto;
  }

  .project-hero-image {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .project-page--down-trigger .project-hero-image {
    position: fixed;
    z-index: -2;
    inset: 0;
    height: 100svh;
    object-position: center 88%;
  }

  .project-facts-section {
    position: relative;
    isolation: isolate;
    padding-top: clamp(3.5rem, 7vw, 6rem);
    background: color-mix(in oklch, var(--color-paper) 92%, var(--color-accent) 8%);
    border-top: 1px solid color-mix(in oklch, var(--color-accent) 42%, transparent);
  }

  .project-facts-section::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(90deg, color-mix(in oklch, var(--color-accent) 7%, transparent), transparent 34%),
      linear-gradient(180deg, rgb(255 255 255 / 0.025), transparent 30%);
    pointer-events: none;
  }

  .project-facts-section .container {
    display: grid;
    gap: var(--space-5);
  }

  .project-facts-label {
    margin: 0;
    color: color-mix(in oklch, var(--color-ink) 72%, var(--color-accent));
  }

  .project-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
  }

  .project-title-row {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 4vw, 3.5rem);
    flex-wrap: wrap;
  }

  .project-title {
    font-size: var(--text-4xl);
    max-width: 18ch;
    font-family: 'Bebas Neue', var(--font-display);
    letter-spacing: 0.025em;
    color: #fff;
    text-shadow: 0 3px 22px rgb(0 0 0 / 0.58);
  }

  .project-summary {
    font-size: var(--text-lg);
    color: rgb(255 255 255 / 0.84);
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.6);
    line-height: var(--leading-relaxed);
    max-width: 48ch;
  }

  .project-badges {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  .project-hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .project-hero .button {
    position: relative;
    z-index: 0;
    display: inline-block;
    width: min(15rem, 100%);
    height: 3.5rem;
    color: #f5efe5;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 300ms ease, letter-spacing 300ms ease;
  }

  .project-hero .button::before,
  .project-hero .button::after,
  .project-hero .button__text::before,
  .project-hero .button__text::after {
    content: '';
    position: absolute;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: all 620ms ease;
  }

  .project-hero .button::before {
    top: 0;
    left: 3.4rem;
    width: calc(100% - 6.8rem - 1rem);
  }

  .project-hero .button::after {
    top: 0;
    right: 3.4rem;
    width: 0.5rem;
  }

  .project-hero .button__text::before {
    right: 3.4rem;
    bottom: 0;
    width: calc(100% - 6.8rem - 1rem);
  }

  .project-hero .button__text::after {
    bottom: 0;
    left: 3.4rem;
    width: 0.5rem;
  }

  .project-hero .button__text {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-align: center;
  }

  .project-hero .button__label {
    color: #f5efe5;
    background-image: linear-gradient(100deg, #00e0ff 0%, #6d5cff 55%, #ff2f9b 100%);
    background-repeat: no-repeat;
    background-size: 0% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    transition: color 620ms ease, background-size 620ms ease;
  }

  .project-hero .button:hover .button__label,
  .project-hero .button:focus-visible .button__label {
    color: transparent;
    background-size: 100% 100%;
  }

  .project-hero .button__line {
    position: absolute;
    top: 0;
    width: 3.5rem;
    height: 100%;
    overflow: hidden;
  }

  .project-hero .button__line::before {
    content: '';
    position: absolute;
    top: 0;
    width: 150%;
    height: 100%;
    box-sizing: border-box;
    border: solid 2px currentColor;
    border-radius: 300px;
    transition: all 620ms ease;
  }

  .project-hero .button__line:nth-child(1),
  .project-hero .button__line:nth-child(1)::before {
    left: 0;
  }

  .project-hero .button__line:nth-child(2),
  .project-hero .button__line:nth-child(2)::before {
    right: 0;
  }

  .project-hero .button:hover,
  .project-hero .button:focus-visible {
    color: #3fe9ff;
  }

  .project-hero .button:hover::before,
  .project-hero .button:hover .button__text::before,
  .project-hero .button:focus-visible::before,
  .project-hero .button:focus-visible .button__text::before {
    width: 0.5rem;
  }

  .project-hero .button:hover::after,
  .project-hero .button:hover .button__text::after,
  .project-hero .button:focus-visible::after,
  .project-hero .button:focus-visible .button__text::after {
    width: calc(100% - 6.8rem - 1rem);
  }

  .project-hero .button:focus-visible {
    outline: 2px solid #3fe9ff;
    outline-offset: 4px;
  }

  .project-hero .btn--ghost {
    border-color: rgb(255 255 255 / 0.58);
    color: rgb(255 255 255 / 0.94);
  }

  .project-hero .eyebrow,
  .project-hero .meta {
    color: rgb(255 255 255 / 0.78);
  }

  .project-hero :global(.badge--neutral) {
    border-color: rgb(255 255 255 / 0.58);
    color: rgb(255 255 255 / 0.9);
  }

  .disclaimer {
    border-left: 3px solid var(--color-accent);
    background: color-mix(in oklch, var(--color-accent) 8%, transparent);
    padding: var(--space-5) var(--space-6);
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
    margin-block: var(--space-6);
    display: grid;
    gap: var(--space-2);
    max-width: var(--container-narrow);
  }

  .disclaimer p {
    color: var(--color-ink-soft);
    line-height: var(--leading-relaxed);
  }

  .project-cover-media {
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-l);
  }

  .project-cover-media :global(img) {
    width: 100%;
  }

  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-6);
  }

  .fact {
    display: grid;
    gap: var(--space-1);
    border-top: var(--border-1);
    padding-top: var(--space-4);
  }

  .fact dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-muted);
  }

  .fact dd {
    margin: 0;
    font-weight: 600;
    line-height: var(--leading-normal);
  }

  .prose :global(h2) {
    font-size: var(--text-xl);
    margin-block: var(--space-8) var(--space-3);
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }

  .prose :global(h3) {
    font-size: var(--text-lg);
    margin-block: var(--space-6) var(--space-2);
  }

  .prose :global(p) {
    margin-block: var(--space-4);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  .prose :global(strong) {
    color: var(--color-ink);
  }

  .results {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-5);
  }

  .result {
    border-top: var(--border-1);
    padding-top: var(--space-4);
    display: grid;
    gap: var(--space-1);
  }

  .result-value {
    font-size: var(--text-3xl);
  }

  .result-unit {
    font-size: var(--text-lg);
    color: var(--color-accent);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-6);
    margin-top: var(--space-5);
  }

  .gallery-item {
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }

  .gallery-item :global(img) {
    width: 100%;
    border-radius: var(--radius-m);
  }

  .mobile-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 16rem));
    gap: var(--space-6);
    margin-top: var(--space-5);
  }

  .mobile-item {
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }

  .mobile-item :global(img) {
    width: 100%;
    aspect-ratio: 9 / 19;
    object-fit: cover;
    border-radius: var(--radius-m);
    border: var(--border-1);
  }

  .project-page :global(.next-project) {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
  }

  .project-page :global(.next-project-link) {
    gap: var(--space-3);
  }

  .project-page :global(.next-project-media) {
    width: min(100%, 20rem);
    aspect-ratio: 16 / 8;
  }

  .project-page :global(.next-project) {
    position: relative;
    z-index: 1;
  }

  :global(.page-main:has(.project-page) + .site-footer) {
    position: relative;
    z-index: 1;
    margin-top: var(--space-3);
    padding-block: var(--space-5) var(--space-4);
    background: color-mix(in oklch, var(--color-paper) 88%, transparent);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }

  .live-cta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    border-top: var(--border-1);
    padding-top: var(--space-6);
  }

  @media (max-width: 700px) {
    .project-title-row {
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
