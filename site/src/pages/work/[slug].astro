---
import { render } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getPublishedProjects } from '../../lib/content';
import { creativeWorkLd } from '../../lib/seo';
export async function getStaticPaths() {
  return (await getPublishedProjects()).map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;
---

<BaseLayout
  title={p.seoTitle ?? p.title}
  description={p.seoDescription ?? p.summary}
  ogImage={p.cover.src}
  jsonLd={[creativeWorkLd(project)]}
  ><article class="container section">
    <a class="text-link" href="/work/">Tous les projets</a><header class="case-head">
      <div>
        <p class="eyebrow">{p.sector} · Site en ligne</p><h1 class="display">{p.title}</h1>
      </div><div>
        <p>{p.summary}</p><a
          class="btn btn--primary"
          href={p.liveUrl}
          target="_blank"
          rel="noopener noreferrer">Visiter le site<span class="sr-only"> (nouvel onglet)</span></a>
      </div>
    </header><figure class="case-media">
      <img src={p.cover.src} alt={p.cover.alt} width={p.slug==='down-trigger'?1151:887} height={p.slug==='down-trigger'?2048:988} fetchpriority="high" />{
        p.capturedAt && p.slug !== 'down-trigger' && <figcaption>Capture du site public · {p.capturedAt}</figcaption>
      }
    </figure><div class="prose"><Content /></div>{
      p.gallery.length > 0 && (
        <div class="gallery">
          {p.gallery.map((m) => (
            <figure>
              <img
                src={m.src}
                alt={m.alt}
                loading="lazy"
                decoding="async"
                width="1200"
                height="750"
              />
              <figcaption>{m.caption}</figcaption>
            </figure>
          ))}
        </div>
      )
    }<div class="case-end">
      <h2 class="display">Un projet à préparer ?</h2><a class="text-link" href="/contact"
        >Parlons de votre site</a>
    </div>
  </article></BaseLayout
><style>
  .text-link {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .case-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: end;
    margin-block: 3rem;
  }
  .case-head h1 {
    font-size: var(--text-4xl);
    margin-top: 1rem;
  }
  .case-head > div:last-child {
    display: grid;
    gap: 2rem;
    justify-items: start;
    color: var(--color-ink-soft);
  }
  figure {
    margin: 0;
  }
  .case-media {
    margin-bottom: 4rem;
  }
  .case-media img {
    width: 100%;
    height: auto;
  }
  .case-media figcaption,
  figcaption {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: 0.8rem;
  }
  .gallery {
    display: grid;
    gap: 3rem;
    margin-top: 4rem;
  }
  .case-end {
    border-top: 1px solid var(--color-line);
    margin-top: 4rem;
    padding-top: 3rem;
    display: grid;
    gap: 1.5rem;
  }
  .case-end h2 {
    font-size: var(--text-3xl);
  }
  @media (max-width: 48rem) {
    .case-head {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
