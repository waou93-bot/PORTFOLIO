---
import BaseLayout from '../components/layout/BaseLayout.astro';
const projects = [
  {
    slug: 'down-trigger',
    name: 'Down Trigger',
    image: 'down-trigger/cover-v2.webp',
    label: 'Musique · signal',
  },
  {
    slug: 'heritage-2',
    name: 'Héritage 2',
    image: 'heritage-2/cover-v2.webp',
    label: 'Patrimoine · matière',
  },
  {
    slug: 'maison-sillon',
    name: 'Maison Sillon',
    image: 'maison-sillon/cover-v3.webp',
    label: 'Architecture · espace',
  },
  { slug: 'vantel', name: 'Vantel', image: 'vantel/cover.webp', label: 'Mode · contraste' },
];
const details = [
  'Collaboration · site en ligne',
  'Concept fictif · étude de cas',
  'Concept architectural · étude de cas',
  'Concept e-commerce · expérience interactive',
];
---

<BaseLayout title="Mon univers — exploration V2" theme="dark" noindex={true}>
  <section
    class="journey"
    data-mountain-journey
    aria-label="Explorer les projets dans les montagnes"
  >
    <div class="journey-stage">
      <div class="journey-heading">
        <a href="/">← Retour au portrait</a><h1>
          Prendre du recul.<br /><em>Découvrir un univers.</em>
        </h1>
      </div>
      <div class="landscape">
        <video data-mountain-video muted playsinline preload="none" aria-hidden="true"></video>
        <div class="summits">
          {
            projects.map((project, i) => (
              <a class="summit" data-summit={i} href={`/work/${project.slug}`} style={`--i:${i}`}>
                <span class="summit-pin" aria-hidden="true">
                  0{i + 1}
                </span>
                <span class="summit-card">
                  <>
                    <img
                      src={`/media/projects/${project.image}`}
                      alt=""
                      width="320"
                      height="200"
                      loading="eager"
                      decoding="async"
                    />
                    <span class="summit-caption">
                      <>
                        <small>{project.label}</small>
                        <strong>{project.name} ↗</strong>
                      </>
                    </span>
                  </>
                  <span class="summit-detail">
                    <>
                      <svg viewBox="0 0 220 65" aria-hidden="true">
                        <path d="M 0 64 L 48 16 H 220" pathLength="1" />
                      </svg>
                      <span>
                        {details[i]}
                        <b>Découvrir le projet ↗</b>
                      </span>
                    </>
                  </span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
      <div class="journey-bottom">
        <p data-journey-status role="status">Préparation du paysage…</p><span
          data-journey-progress
          aria-hidden="true">00 / 100</span
        >
      </div>
      <div class="journey-meter" aria-hidden="true"><i data-journey-meter></i></div>
    </div>
  </section>
  <nav class="journey-index" aria-label="Accès direct aux quatre projets">
    <p>Quatre directions, une même curiosité.</p>
    {
      projects.map((project, i) => (
        <a href={`/work/${project.slug}`}>
          0{i + 1} — {project.name} ↗
        </a>
      ))
    }
  </nav>
</BaseLayout>
<script>
  import { initMountainJourney } from '../lib/mountain-journey';
  initMountainJourney();
  document.addEventListener('astro:page-load', initMountainJourney);
</script>
<style>
  .journey {
    height: 480svh;
    position: relative;
    background: #ddb392;
    color: #fff4e7;
  }
  .journey-stage {
    height: 100svh;
    position: sticky;
    top: 0;
    overflow: clip;
    isolation: isolate;
  }
  .landscape {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100%, 177.778svh);
    aspect-ratio: 16/9;
    transform: translate(-50%, -50%);
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .journey-heading {
    position: absolute;
    z-index: 4;
    right: 4vw;
    top: 32px;
    text-shadow: 0 2px 18px #452b25;
    pointer-events: none;
  }
  .journey-heading a {
    pointer-events: auto;
  }
  .journey-heading a {
    font-size: 0.75rem;
    color: inherit;
  }
  .journey-heading h1 {
    font-size: clamp(1.8rem, 3vw, 3.4rem);
    line-height: 1.05;
    margin: 26px 0 0;
    font-weight: 400;
  }
  .journey-heading em {
    font-weight: 400;
  }
  .summit {
    position: absolute;
    left: 35%;
    top: 40%;
    width: 1px;
    height: 1px;
    color: #fff7ef;
    z-index: 2;
    --dx: 0px;
    --dy: -22px;
    opacity: 0;
    visibility: hidden;
    transform: scale(var(--depth, 1));
    transform-origin: 0 0;
    transition: opacity 0.25s;
  }
  .summit[data-visible='true'] {
    opacity: 1;
    visibility: visible;
  }
  .summit:nth-child(2) {
    --dx: 75px;
    --dy: -35px;
  }
  .summit:nth-child(3) {
    --dx: -90px;
    --dy: -20px;
  }
  .summit:nth-child(4) {
    --dx: 60px;
    --dy: -20px;
  }
  .summit::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: var(--stem, 22px);
    height: 1px;
    background: #fff9;
    transform: rotate(var(--angle, -90deg));
    transform-origin: left;
  }
  .summit-pin {
    position: absolute;
    width: 28px;
    height: 28px;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border: 1px solid #fff9;
    border-radius: 50%;
    background: #332a27b8;
    font-size: 10px;
  }
  .summit-card {
    display: block;
    position: absolute;
    width: 148px;
    left: var(--dx);
    top: var(--dy);
    transform: translate(-50%, -100%);
    background: #241f1bee;
    border: 1px solid #ffe3c260;
    border-radius: 6px;
    box-shadow: 0 10px 28px #2f180b35;
    transition:
      scale 0.25s,
      box-shadow 0.25s;
    transform-origin: bottom center;
  }
  .summit-detail {
    position: absolute;
    left: 100%;
    bottom: 55%;
    width: 220px;
    pointer-events: none;
  }
  .summit-detail svg {
    width: 220px;
    height: 65px;
    display: block;
    overflow: visible;
  }
  .summit-detail path {
    fill: none;
    stroke: #fff2dc;
    stroke-width: 1.4;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.32s ease-out;
  }
  .summit-detail > span {
    position: absolute;
    left: 48px;
    bottom: 54px;
    width: 185px;
    background: #332822e8;
    padding: 10px 12px;
    font-size: 11px;
    line-height: 1.5;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.15s,
      transform 0.15s;
  }
  .summit-detail b {
    display: block;
    font-size: 12px;
    margin-top: 5px;
  }
  .summit:is(:hover, :focus-visible) .summit-detail path {
    stroke-dashoffset: 0;
  }
  .summit:is(:hover, :focus-visible) .summit-detail > span {
    opacity: 1;
    transform: none;
    transition-delay: 0.18s;
  }
  .summit img {
    width: 100%;
    height: 82px;
    object-fit: cover;
    display: block;
  }
  .summit-caption {
    display: grid;
    padding: 10px;
    gap: 4px;
  }
  .summit small {
    font-size: 9px;
    color: #ddc4af;
  }
  .summit strong {
    font-size: 13px;
    font-weight: 600;
  }
  .summit:hover,
  .summit:focus-visible {
    z-index: 8;
  }
  .summit:hover .summit-card,
  .summit:focus-visible .summit-card {
    scale: 1.09;
    box-shadow: 0 12px 36px #23130580;
    outline: 1px solid #fff8;
  }
  .journey-bottom {
    position: absolute;
    bottom: 32px;
    left: 4vw;
    right: 4vw;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-shadow: 0 2px 8px #321e15;
    font-size: 0.8rem;
  }
  .journey-bottom p {
    margin: 0;
  }
  .journey-meter {
    position: absolute;
    bottom: 0;
    height: 3px;
    width: 100%;
    background: #ffffff30;
  }
  .journey-meter i {
    display: block;
    height: 100%;
    background: #fff2dd;
    transform-origin: left;
    transform: scaleX(0);
  }
  .journey-index {
    padding: 4rem 5vw;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .journey-index p {
    flex-basis: 100%;
  }
  .journey-index a {
    color: inherit;
  }
  @media (max-width: 700px) {
    .journey {
      height: 360svh;
    }
    .landscape {
      width: 100%;
      top: 43%;
    }
    .journey-heading {
      top: 28px;
      left: 6vw;
      right: 6vw;
    }
    .journey-heading h1 {
      font-size: 2rem;
    }
    .summit-card {
      width: 90px;
    }
    .summit img {
      height: 45px;
    }
    .summit-caption {
      padding: 5px;
    }
    .summit small,
    .summit-detail,
    .summit-pin {
      display: none;
    }
    .summit strong {
      font-size: 10px;
    }
    .summit:nth-child(2) {
      --dx: 45px;
    }
    .summit:nth-child(3) {
      --dx: -40px;
    }
    .journey-bottom {
      bottom: 8vh;
      left: 6vw;
      right: 6vw;
      font-size: 0.72rem;
    }
    .journey-index {
      display: grid;
      gap: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .journey {
      height: 100svh;
    }
    .summit-card {
      transition: none;
    }
  }
</style>
