# Public production site URL (no trailing slash)
SITE_URL=https://www.wadek.fr
# For local-only checks, override this process variable with http://localhost:4321.

# Contact form — destination email
CONTACT_EMAIL=contact@example.com

# Contact form — anti-spam (rate limiting) secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_FORM_SECRET=

# Analytics (optional). Leave empty to disable.
# PUBLIC_ANALYTICS_URL=
# PUBLIC_ANALYTICS_DOMAIN=
